    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.363.0",
    "pg": "^8.13.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
