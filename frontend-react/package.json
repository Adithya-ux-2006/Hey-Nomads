    "seed:demo": "node --import ./scripts/dns-shim.mjs scripts/seed-test-data.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:fixtures": "node --import ./scripts/dns-shim.mjs scripts/verify-checklist-fixtures.mjs",
    "verify:api": "node --import ./scripts/dns-shim.mjs scripts/verify-api-flows.mjs",
    "verify:deploy": "node scripts/verify-deploy-contract.mjs",
    "verify": "npm run lint && npm run verify:security && npm run verify:fixtures && npm run verify:api && npm run verify:deploy"
  },
  "dependencies": {
    "@sentry/node": "^11.4.0",
